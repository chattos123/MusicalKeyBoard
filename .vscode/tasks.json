{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Build All",
            "type": "shell",
            "command": "cmake --build build --config Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake --build build --target clean",
            "problemMatcher": []
        }
    ]
}